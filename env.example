PORT=3000

# HubSpot private app (create under Settings > Integrations > Private Apps)
# Required scopes: crm.objects.contacts.read, crm.objects.companies.read
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_OWNER_ID=
HUBSPOT_PORTAL_ID=

# Slack app (create at api.slack.com/apps)
# Required scope: chat:write
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
